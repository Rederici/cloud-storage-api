# Application environment: dev / prod
ENV=dev

# Session lifetime
SESSION_TTL=7d

# PostgreSQL database
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASS=postgres
POSTGRES__NAME=postgres

# Redis
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASS=redis
REDIS__DB=0

# Rustfs object storage
RUSTFS__HOST=rustfs
RUSTFS__PORT=9000
RUSTFS__ACCESS_KEY=rustfs
RUSTFS__SECRET_KEY=rustfs
RUSTFS__BUCKET=resources-bucket
RUSTFS__SSL=false

# CORS configuration
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_ORIGINS=["http://127.0.0.1"]
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]

# API documentation
# Enables Swagger UI at /docs and Redoc at /redoc
SWAGGER_ENABLE=true
