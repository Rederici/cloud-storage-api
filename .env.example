# Application environment: dev / prod
ENV=dev

# Session lifetime
SESSION_TTL=7d

# PostgreSQL database
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASS=postgres
POSTGRES__NAME=postgres

# Redis
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASS=redis
REDIS__DB=0

# MinIO object storage
MINIO__HOST=minio
MINIO__PORT=9000
MINIO__ACCESS_KEY_ID=minio
MINIO__SECRET_ACCESS_KEY=minio123
MINIO__BUCKET=resources-bucket
MINIO__SSL=false

# CORS configuration
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_ORIGINS=["http://127.0.0.1"]
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]

# API documentation
# Enables Swagger UI at /docs and Redoc at /redoc
SWAGGER_ENABLE=true
